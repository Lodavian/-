# Optional developer fallback. Normal users bind through the local page and
# Windows Credential Manager. Never commit real values.
FAST_ORDER_WEBULL_APP_KEY=
FAST_ORDER_WEBULL_APP_SECRET=

# Optional. Required when the credentials return more than one account.
FAST_ORDER_WEBULL_ACCOUNT_ID=
# 多账户时建议只填掩码提示（例如 VPH***7NA），避免完整 Account ID 落盘。
FAST_ORDER_WEBULL_ACCOUNT_HINT=

# Sandbox is the safe default. Set false only when you intentionally want live trading.
FAST_ORDER_SANDBOX=true
# LIVE requires this explicit opt-in plus every LIVE cap below. Keep false for normal testing.
FAST_ORDER_LIVE_ALLOWED=false
FAST_ORDER_DEFAULT_SYMBOL=AAPL
FAST_ORDER_MAX_ORDER_QTY=1000
FAST_ORDER_MAX_ORDER_VALUE=25000
FAST_ORDER_MAX_MARKET_QTY=100
FAST_ORDER_MAX_MARKET_ESTIMATED_VALUE=5000
FAST_ORDER_MAX_DAILY_GROSS_NOTIONAL=25000
FAST_ORDER_MAX_OPEN_ORDERS=1
FAST_ORDER_QUOTE_STALE_SECONDS=8
FAST_ORDER_PORT=8765

# Network deadlines (seconds). Orders are never retried automatically after a timeout.
FAST_ORDER_SDK_CONNECT_TIMEOUT=10
FAST_ORDER_SDK_READ_TIMEOUT=15
FAST_ORDER_SDK_TOTAL_TIMEOUT=20
